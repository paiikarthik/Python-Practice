class Solution {
    public int maxProduct(int[] nums) {
       
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                if nums[j]>nums[j+1]
                   temp=nums[j]
                   nums[j]=nums[j+1]
                   nums[j+1]=temp;
            }
            return nums
        }
    }
}

