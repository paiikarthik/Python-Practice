class Node:
    def __init__(self,data):
        self.data=data
        self.next=None

#creating nodes
node1=Node(10)
node2=Node(20)
node3=Node(30)
node4=Node(40)
node5=Node(50)


#linking nodes
node1.next=node2
node2.next=node3
node3.next=node4
node4.next=node5

data=40

current=node1
found=False
while current is not None:
    if(data==current.data):
        found=True
    
    current=current.next
if(found):
    print("Element Found")
else:
    print("None")
